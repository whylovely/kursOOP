<Window x:Class="kursOOP.Views.AgreementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление договорами" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="AgreementDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Создать договор" Margin="5" Click="CreateAgreement"/>
            <Button Content="Редактировать" Margin="5" Click="EditAgreement"/>
            <Button Content="Завершить договор" Margin="5" Click="TerminateAgreement"/>
        </StackPanel>
    </Grid>
</Window>
