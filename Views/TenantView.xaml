<Window x:Class="kursOOP.Views.TenantView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление арендаторами" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="TenantDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Добавить" Margin="5" Click="AddTenant"/>
            <Button Content="Редактировать" Margin="5" Click="EditTenant"/>
            <Button Content="Удалить" Margin="5" Click="DeleteTenant"/>
        </StackPanel>
    </Grid>
</Window>