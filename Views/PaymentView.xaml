<Window x:Class="kursOOP.Views.PaymentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление платежами" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="PaymentDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Добавить платёж" Margin="5" Click="AddPayment"/>
            <Button Content="Удалить платёж" Margin="5" Click="DeletePayment"/>
        </StackPanel>
    </Grid>
</Window>
