<Window x:Class="kursOOP.Views.OwnerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление владельцами" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="OwnerDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Добавить" Margin="5" Click="AddOwner"/>
            <Button Content="Редактировать" Margin="5" Click="EditOwner"/>
            <Button Content="Удалить" Margin="5" Click="DeleteOwner"/>
        </StackPanel>
    </Grid>
</Window>
