<Window x:Class="kursOOP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система аренды недвижимости" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <Button Content="Управление недвижимостью" Margin="5" Click="OpenPropertyView"/>
            <Button Content="Управление владельцами" Margin="5" Click="OpenOwnerView"/>
            <Button Content="Управление арендаторами" Margin="5" Click="OpenTenantView"/>
            <Button Content="Управление договорами" Margin="5" Click="OpenAgreementView"/>
            <Button Content="Управление платежами" Margin="5" Click="OpenPaymentView"/>
        </StackPanel>
    </Grid>
</Window>